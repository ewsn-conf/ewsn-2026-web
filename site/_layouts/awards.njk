{% extends "page.njk" %}

{% block extended %}
<div class="awards-section">
{% for award in awards  %}
    <div class="papers-tile tile">
        {% if award.key %}
        {% if award.list == "papers" %}
        {% set paper = papers | findByKey(award.key)%}
        {% elseif award.list == "posters-demos" %}
        {% set paper = postersDemos | findByKey(award.key)%}
        {% endif %}

        <h3 class="align-content-center mb-3"> <i class="bi bi-award award-icon-gold"></i> {{ award.award }}</h3>
        <div class="d-flex justify-content-between">
        <h5>{{ paper.title }}</h5>
        {% if paper.pdf %}
        <span>    [<a href="{{ paper.pdf }}" target="_blank">PDF</a>]</span>
        {% endif %}
        </div>
        <div>
            {% for author in paper.authors  %}
                 <span class="light">{{ author.name }} ({{author.affiliation}});</span>
            {% endfor %}
        </div>
        {% elseif award.members %}
        <h3 class="align-content-center mb-3"> {{ award.award }}</h3>
        <div class="row">
            {% for member in award.members  %}
            <div class="col-12 col-sm-6 col-md-4 col-xl-3 py-2 px-4 d-flex author-block">
                <i class="bi bi-award award-icon-gold award-icon-small me-1"></i>
                <div>
                <p class="m-0"> {{ member.name }}</p>
                <p class="m-0 light">{{member.affiliation}}</p>
                </div>
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>
{% endfor %}

</div>
{% endblock %}
